#!/usr/bin/env bash
set -euo pipefail

# Install the audit-skills pre-commit hook.
# Run this once after cloning the repository.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HOOK_DIR="$REPO_ROOT/.git/hooks"

if [[ ! -d "$HOOK_DIR" ]]; then
    echo "Error: .git/hooks directory not found. Is this a git repository?"
    exit 1
fi

cat > "$HOOK_DIR/pre-commit" << 'EOF'
#!/usr/bin/env bash
set -euo pipefail

# Run skill audit before every commit
REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/.hooks/audit-skills"
EOF

chmod +x "$HOOK_DIR/pre-commit"
echo "Pre-commit hook installed. Skills will be audited before every commit."
